DATABASE_URL=postgresql+psycopg2://user:password@db-host:5432/user_management
SECRET_KEY=replace-with-a-random-32-byte-secret
SECRET_KEY_PASSWORD_RESET=replace-with-a-different-random-secret
RESEND_API_KEY=replace-with-your-email-provider-key
RESEND_FROM_EMAIL=no-reply@example.com
FRONTEND_BASE_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_TIME=30
REFRESH_TOKEN_EXPIRE_DAYS=15
ACTIVITY_RETENTION_DAYS=15
PASSWORD_RESET_EXPIRE_MINUTES=15
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
